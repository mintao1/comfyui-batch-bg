{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{INPUT_IMAGE}}" },
    "_meta": { "title": "输入图片" }
  },
  "2": {
    "class_type": "RMBG",
    "inputs": { "image": ["1", 0], "model": "{{RMBG_MODEL}}" },
    "_meta": { "title": "抠图（ComfyUI-RMBG）" }
  },
  "10": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "{{CHECKPOINT}}" },
    "_meta": { "title": "SD 模型" }
  },
  "11": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{PROMPT}}", "clip": ["10", 1] },
    "_meta": { "title": "正向提示词" }
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{NEGATIVE}}", "clip": ["10", 1] },
    "_meta": { "title": "反向提示词" }
  },
  "13": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "{{GEN_WIDTH}}", "height": "{{GEN_HEIGHT}}", "batch_size": 1 },
    "_meta": { "title": "生成尺寸" }
  },
  "14": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["10", 0],
      "positive": ["11", 0],
      "negative": ["12", 0],
      "latent_image": ["13", 0],
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": "{{CFG}}",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    },
    "_meta": { "title": "生成背景" }
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["14", 0], "vae": ["10", 2] },
    "_meta": { "title": "解码" }
  },
  "6": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["15", 0],
      "upscale_method": "lanczos",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "crop": "center"
    },
    "_meta": { "title": "背景缩放裁剪到原图尺寸" }
  },
  "4": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["6", 0],
      "source": ["1", 0],
      "mask": ["2", 1],
      "x": 0,
      "y": 0,
      "resize_source": false
    },
    "_meta": { "title": "合成" }
  },
  "5": {
    "class_type": "SaveImage",
    "inputs": { "images": ["4", 0], "filename_prefix": "batch_bg/prompt" },
    "_meta": { "title": "保存" }
  }
}
