{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{INPUT_IMAGE}}" },
    "_meta": { "title": "输入图片" }
  },
  "2": {
    "class_type": "RMBG",
    "inputs": { "image": ["1", 0], "model": "{{RMBG_MODEL}}" },
    "_meta": { "title": "抠图（ComfyUI-RMBG）" }
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{BG_IMAGE}}" },
    "_meta": { "title": "背景图" }
  },
  "6": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["3", 0],
      "upscale_method": "lanczos",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "crop": "center"
    },
    "_meta": { "title": "背景缩放裁剪到原图尺寸" }
  },
  "4": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["6", 0],
      "source": ["1", 0],
      "mask": ["2", 1],
      "x": 0,
      "y": 0,
      "resize_source": false
    },
    "_meta": { "title": "合成" }
  },
  "5": {
    "class_type": "SaveImage",
    "inputs": { "images": ["4", 0], "filename_prefix": "batch_bg/replace" },
    "_meta": { "title": "保存" }
  }
}
