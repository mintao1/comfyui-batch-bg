# 复制为 .env 后按需修改；取消注释（去掉行首 #）即生效。
# 本地运行和 docker compose 都会读取本文件。

# ComfyUI 地址。不设置时：本地运行默认 http://127.0.0.1:8188，
# Docker 运行默认 http://host.docker.internal:8188（注意 Docker 下不能写 127.0.0.1）
# COMFYUI_URL=http://127.0.0.1:8188

# 抠图模型：RMBG-2.0（非商用许可）/ BEN2 / BEN / INSPYRENET
RMBG_MODEL=RMBG-2.0

# AI 生成背景用的模型（ComfyUI/models/checkpoints 下的文件名）
SD_CHECKPOINT=sd_xl_base_1.0.safetensors

MAX_CONCURRENCY=2
JOB_TIMEOUT=600
MAX_UPLOAD_MB=30
